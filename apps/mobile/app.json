{
  "expo": {
    "name": "Kairn",
    "slug": "kairn",
    "version": "0.1.0",
    "scheme": "kairn",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "dev.kairn.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "dev.kairn.app",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.33.0"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SourceSans3-Regular.ttf",
            "./assets/fonts/SourceSans3-Semibold.ttf",
            "./assets/fonts/SourceSans3-Bold.ttf"
          ]
        }
      ]
    ]
  }
}
