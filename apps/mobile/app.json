{
  "expo": {
    "name": "Kairn",
    "slug": "kairn",
    "version": "0.1.0",
    "scheme": "kairn",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "dev.kairn.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "dev.kairn.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#FBFAF6"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "backgroundColor": "#FBFAF6",
          "imageWidth": 112,
          "dark": {
            "image": "./assets/brand/splash-dark.png",
            "backgroundColor": "#1B1D1A"
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.33.0"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SourceSans3-Regular.ttf",
            "./assets/fonts/SourceSans3-Semibold.ttf",
            "./assets/fonts/SourceSans3-Bold.ttf"
          ]
        }
      ]
    ],
    "icon": "./assets/brand/app-icon.png"
  }
}
