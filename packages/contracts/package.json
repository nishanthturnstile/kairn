{
  "name": "@kairn/contracts",
  "private": true,
  "type": "module",
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./journeys": {
      "types": "./src/journeys.ts",
      "react-native": "./src/journeys.ts",
      "browser": "./src/journeys.ts",
      "development": "./src/journeys.ts",
      "import": "./dist/journeys.js"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "import": "./dist/schemas.js"
    },
    "./recordings": {
      "types": "./src/recordings.ts",
      "react-native": "./src/recordings.ts",
      "browser": "./src/recordings.ts",
      "development": "./src/recordings.ts",
      "import": "./dist/recordings.js"
    },
    "./recording-limits": {
      "types": "./src/recording-limits.ts",
      "react-native": "./src/recording-limits.ts",
      "browser": "./src/recording-limits.ts",
      "development": "./src/recording-limits.ts",
      "import": "./dist/recording-limits.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript openapi.json -o src/generated/api.ts",
    "api:check": "openapi-typescript openapi.json -o src/generated/api.ts --check"
  },
  "dependencies": {
    "@kairn/sync-protocol": "workspace:*",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  }
}
