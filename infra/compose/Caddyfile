{
	admin off
}

:8080 {
	@media path /media /media/*
	handle @media {
		reverse_proxy {$KAIRN_API_UPSTREAM} {
			header_down Cache-Control "private, no-store"
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$KAIRN_API_UPSTREAM}
	}

	handle {
		reverse_proxy {$KAIRN_WEB_UPSTREAM}
	}
}
