{
  "name": "kairn",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite-plus": "1.7.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vp run @kairn/web#dev",
    "dev:server": "vp run @kairn/server#dev",
    "dev:worker": "vp run @kairn/worker#dev",
    "dev:mobile": "vp run @kairn/mobile#dev",
    "android": "vp run @kairn/mobile#android",
    "ios": "vp run @kairn/mobile#ios",
    "check": "biome ci && vp run typecheck",
    "format": "biome format --write",
    "typecheck": "vp run --filter \"@kairn/*\" typecheck",
    "test": "vp test run",
    "build": "vp run --filter \"@kairn/*\" build",
    "services:up": "docker compose -f infra/compose/dev.yml up -d --wait",
    "services:down": "docker compose -f infra/compose/dev.yml down",
    "db:generate": "vp run @kairn/backend#db:generate",
    "db:migrate": "vp run @kairn/backend#db:migrate",
    "db:queue": "vp run @kairn/backend#db:queue",
    "test:integration": "KAIRN_INTEGRATION=1 vp test run tests/integration",
    "api:generate": "pnpm --filter @kairn/server api:emit && pnpm --filter @kairn/contracts api:generate",
    "api:check": "pnpm --filter @kairn/server api:emit --check && pnpm --filter @kairn/contracts api:check",
    "test:web": "playwright test",
    "test:identity:recovery": "bash tests/integration/isolated-identity.sh",
    "identity:replay": "pnpm --filter @kairn/backend identity:replay"
  }
}
