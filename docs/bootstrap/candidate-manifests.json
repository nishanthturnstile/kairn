{
  "runtime": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "generators": {
    "vite-plus": "1.7.0",
    "create-vite": "9.3.4",
    "create-hono": "0.19.5",
    "create-expo": "5.1.9",
    "expo-template-default": "58.0.35",
    "shadcn": "4.23.0",
    "expo-doctor": "1.21.8"
  },
  "workspace": {
    "packages": ["apps/*", "packages/*"],
    "strictPeerDependencies": true,
    "allowBuilds": {
      "esbuild": true
    },
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
      "vitest@*": "5.1.0"
    }
  },
  "manifests": {
    ".": {
      "name": "kairn",
      "private": true,
      "type": "module",
      "engines": {
        "node": "24.22.3"
      },
      "devEngines": {
        "packageManager": {
          "name": "pnpm",
          "version": "12.21.0",
          "onFail": "download"
        }
      },
      "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "typescript": "6.0.3",
        "vite-plus": "1.7.0"
      }
    },
    "apps/web": {
      "name": "@kairn/web",
      "private": true,
      "type": "module",
      "dependencies": {
        "@tanstack/react-query": "5.108.0",
        "@tanstack/react-router": "1.170.46",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "4.3.5"
      },
      "devDependencies": {
        "@tailwindcss/vite": "4.3.5",
        "@tanstack/router-plugin": "1.169.0",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "typescript": "6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "vite-plus": "1.7.0"
      }
    },
    "apps/server": {
      "name": "@kairn/server",
      "private": true,
      "type": "module",
      "dependencies": {
        "@hono/node-server": "2.1.9",
        "hono": "4.13.19"
      },
      "devDependencies": {
        "@types/node": "24.19.2",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
      }
    },
    "apps/mobile": {
      "name": "@kairn/mobile",
      "private": true,
      "main": "./index.js",
      "dependencies": {
        "@react-native/normalize-colors": "0.88.1",
        "@rnmapbox/maps": "10.3.18",
        "expo": "58.0.26",
        "expo-constants": "58.0.16",
        "expo-dev-client": "58.0.21",
        "expo-linking": "58.0.17",
        "expo-router": "58.0.32",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "3.3.0",
        "react-native-nitro-modules": "0.37.2",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "5.11.1",
        "react-native-screens": "4.30.1",
        "react-native-unistyles": "3.8.2",
        "react-native-worklets": "0.13.0"
      },
      "devDependencies": {
        "@types/react": "19.3.0",
        "babel-preset-expo": "58.0.26",
        "typescript": "6.0.3"
      }
    }
  }
}
